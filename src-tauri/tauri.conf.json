{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bkgrnd",
  "identifier": "com.bedlamlabs.bkgrnd",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "bkgrnd",
        "label": "main",
        "width": 300,
        "height": 200,
        "minWidth": 300,
        "minHeight": 120,
        "maxHeight": 600,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/mpv-bundle/*": "mpv-bundle/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "externalBin": [
      "binaries/yt-dlp"
    ]
  },
  "plugins": {}
}
